# ---------------------------------------------------------------------------
# Copie para `.env` e preencha. O `.env` é ignorado pelo git (.gitignore:11).
# Carregado automaticamente pelo pytest via tests/conftest.py.
# ---------------------------------------------------------------------------

# --- Gemini -----------------------------------------------------------------
# Lido diretamente pelo SDK google-genai em GeminiClient (src/llm/gemini.py).
# Chave do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- API industrial local ---------------------------------------------------
# Suba com: cd inteli-tractian-project && make up-api
TRACTIAN_API_URL=http://127.0.0.1:8000

# --- Material da TRACTIAN (opcional) ----------------------------------------
# Só defina se o contrato/casos vierem de fora de inteli-tractian-project/agent-input.
# TRACTIAN_CONTRACT_PATH=
# TRACTIAN_CASES_PATH=

# ---------------------------------------------------------------------------
# Ainda NÃO consumidos por nenhum código — placeholders para as fases pendentes.
# ---------------------------------------------------------------------------
# Modelos do plano experimental (doc 07 §132-135). Hoje o default está fixo
# em `gemini-2.5-flash` na assinatura de GeminiClient.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL_LITE=gemini-2.5-flash-lite

# Langfuse — o sink secundário (ADR-14) ainda não existe em src/storage/.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
